<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Banner Image -->
        <ImageView
            android:id="@+id/ivRecipeDetailImage"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_logo"
            android:background="#E5E7EB"/>

        <!-- Details Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvRecipeDetailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spicy Garlic Shrimp"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvRecipeDetailDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A quick and easy dish that uses up your expiring garlic and shrimp in just 15 minutes."
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="24dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F3F4F6"
                android:layout_marginBottom="20dp"/>

            <!-- Ingredients -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingredients Required"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvRecipeIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Shrimp\n• Garlic cloves\n• Olive Oil\n• Chili Flakes"
                android:textSize="14sp"
                android:textColor="#374151"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F3F4F6"
                android:layout_marginBottom="20dp"/>

            <!-- Steps -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step-by-step Instructions"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvRecipeInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Heat olive oil in a skillet over medium heat.\n2. Sauté garlic until fragrant.\n3. Add shrimp and cook until pink.\n4. Toss with chili flakes and serve warm."
                android:textSize="14sp"
                android:textColor="#374151"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
