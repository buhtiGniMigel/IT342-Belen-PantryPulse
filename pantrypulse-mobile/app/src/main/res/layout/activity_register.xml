<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F9FAFB"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Top Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <!-- Brand Header - Compact -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="#2E7D32"
            android:elevation="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_logo"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PantryPulse"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#111827" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Portal"
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:layout_marginBottom="20dp" />

        <!-- Main Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:layout_marginHorizontal="4dp">

            <!-- Gradient Bar -->
            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@drawable/bg_gradient_header" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Account"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Join PantryPulse to manage your inventory"
                    android:textSize="13sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="20dp" />

                <!-- Name Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <!-- First Name -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="First Name"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#374151"
                            android:layout_marginBottom="4dp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="44dp">

                            <EditText
                                android:id="@+id/etFirstName"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_input"
                                android:hint="John"
                                android:inputType="textPersonName"
                                android:paddingStart="36dp"
                                android:paddingEnd="10dp"
                                android:textSize="14sp"
                                android:textColor="#1F2937"
                                android:textColorHint="#9CA3AF" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center_vertical|start"
                                android:layout_marginStart="10dp"
                                android:src="@drawable/ic_person" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Last Name -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last Name"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#374151"
                            android:layout_marginBottom="4dp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="44dp">

                            <EditText
                                android:id="@+id/etLastName"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_input"
                                android:hint="Doe"
                                android:inputType="textPersonName"
                                android:paddingStart="36dp"
                                android:paddingEnd="10dp"
                                android:textSize="14sp"
                                android:textColor="#1F2937"
                                android:textColorHint="#9CA3AF" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center_vertical|start"
                                android:layout_marginStart="10dp"
                                android:src="@drawable/ic_person" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Email Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#374151"
                    android:layout_marginBottom="4dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="14dp">

                    <EditText
                        android:id="@+id/etRegEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_input"
                        android:hint="john@company.com"
                        android:inputType="textEmailAddress"
                        android:paddingStart="36dp"
                        android:paddingEnd="10dp"
                        android:textSize="14sp"
                        android:textColor="#1F2937"
                        android:textColorHint="#9CA3AF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="12dp"
                        android:text="@"
                        android:textColor="#9CA3AF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Password Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#374151"
                    android:layout_marginBottom="4dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="4dp">

                    <EditText
                        android:id="@+id/etRegPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_input"
                        android:hint="Min 8 characters"
                        android:inputType="textPassword"
                        android:paddingStart="36dp"
                        android:paddingEnd="10dp"
                        android:textSize="14sp"
                        android:textColor="#1F2937"
                        android:textColorHint="#9CA3AF" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_lock" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Must contain at least 8 characters"
                    android:textSize="11sp"
                    android:textColor="#9CA3AF"
                    android:layout_marginBottom="20dp" />

                <!-- Register Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Create Account"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/selector_button_primary"
                    android:elevation="2dp"
                    android:stateListAnimator="@null" />

                <!-- Message Container -->
                <LinearLayout
                    android:id="@+id/llMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card"
                    android:backgroundTint="#FEF2F2"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_card"
                        android:backgroundTint="#EF4444"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="×"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Email already exists"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#991B1B" />
                </LinearLayout>

                <!-- Footer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Already have an account? "
                        android:textSize="13sp"
                        android:textColor="#6B7280" />

                    <TextView
                        android:id="@+id/tvBackToLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign in here"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="© 2026 PantryPulse. All rights reserved."
            android:textSize="11sp"
            android:textColor="#9CA3AF" />

    </LinearLayout>
</ScrollView>